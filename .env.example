# Copy to .env (never commit .env). Server loads it via `node --env-file=.env src/server.js` or your shell.
# Optional: Gemini free-tier key for LLM extraction (regex fallback is used if unset)
GEMINI_API_KEY=
# Optional: PayPal sandbox REST app credentials (MOCK mode is used if unset)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox business (merchant) account email that owns the invoices, and a sandbox buyer email
PAYPAL_INVOICER_EMAIL=
PAYPAL_BUYER_EMAIL=
PORT=3000
